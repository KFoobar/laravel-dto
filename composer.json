{
    "name": "kfoobar/laravel-dto",
    "description": "Basic Data Transfer Object for Laravel",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "KFoobar",
            "email": "david@kfoobar.se"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "nesbot/carbon": "^3.8.4"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "KFoobar\\Data\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KFoobar\\Data\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
